# --- required -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
OPENAI_API_KEY=sk-...

# --- OpenAI ---------------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # set for a proxy / compatible API
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1024
OPENAI_TIMEOUT=120
# SYSTEM_PROMPT=Ты — саркастичный ассистент в чате.

# --- behaviour ------------------------------------------------------------
# Comma-separated wake words. A message must start with one of them.
TRIGGER_PREFIXES=ии
# How many recent chat messages are fed to the model as context.
HISTORY_LIMIT=40
HISTORY_MAX_CHARS=12000
# Log every message the bot can see (needs Privacy Mode OFF in BotFather).
LOG_ALL_MESSAGES=true
# Restrict /clear_history to group admins.
CLEAR_REQUIRES_ADMIN=false

# --- typewriter effect ----------------------------------------------------
# Seconds between message edits. Below ~1.0 Telegram starts rate limiting.
TYPEWRITER_INTERVAL=1.1
# Minimum new characters before an edit is worth it.
TYPEWRITER_MIN_CHARS=24
TYPEWRITER_CURSOR=▍

# --- misc -----------------------------------------------------------------
DB_PATH=data/bot.db
LOG_LEVEL=INFO
